# ===========================================
# Production Environment Variables
# ===========================================
# Copy this file as .env on the cPanel server
# and fill in the actual values.

# Database - gunakan credentials dari cPanel MySQL Databases
DATABASE_URL="mysql://cpanel_dbuser:password@localhost:3306/cpanel_dbname"

# JWT Authentication
JWT_SECRET="ganti_dengan_random_string_yang_panjang_dan_aman"

# Server
PORT=5500
NODE_ENV=production

# CORS - domain frontend yang diizinkan
CORS_ORIGIN=https://your-domain.com
